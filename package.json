{
  "name": "warframe-inventory-tracker",
  "version": "2.1.1",
  "description": "Warframe Inventory Tracker",
  "author": "Tyler",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder -w",
    "release": "electron-builder -w --publish always"
  },
  "dependencies": {
    "axios": "^1.18.1"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.tyler.warframe.inventorytracker",
    "productName": "Warframe Inventory Tracker",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "dashboard.html",
      "dashboard.js",
      "styles.css",
      "assets/**/*",
      "bundled-relic-cache.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "williamstylerg",
      "repo": "warframe-inventory-tracker"
    }
  }
}
