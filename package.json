{
  "name": "warframe-inventory-tracker",
  "version": "2.4.0",
  "description": "Warframe Inventory Tracker",
  "author": "Tyler",
  "license": "GPL-3.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "npm run build:renderer && electron-builder -w",
    "release": "npm run build:renderer && electron-builder -w --publish always",
    "build:renderer": "esbuild src/renderer.js --bundle --outfile=dashboard-bundle.js",
    "lint": "eslint main.js preload.js src/",
    "format": "prettier --write main.js preload.js src/ *.html",
    "test": "jest"
    
  },
  "dependencies": {
    "axios": "^1.18.1",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^27.0.0-alpha.8",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.1",
    "prettier": "^3.9.6"
  },
  "build": {
    "appId": "com.tyler.warframe.inventorytracker",
    "productName": "Warframe Inventory Tracker",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "dashboard.html",
      "dashboard-bundle.js",
      "assets/**/*",
      "bundled-relic-cache.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "williamstylerg",
      "repo": "warframe-inventory-tracker"
    }
  }
}
